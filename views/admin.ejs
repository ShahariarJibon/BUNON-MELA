<!-- Modal Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const editModal = document.getElementById('editProductModal');
    const closeBtn = document.getElementById('closeEditModal');
    const cancelBtn = document.getElementById('cancelEditModal');
    const editForm = document.getElementById('editProductForm');
    const editTitle = document.getElementById('editTitle');
    const editCatSelect = document.getElementById('editCategorySelect');
    const editPrice = document.getElementById('editPrice');
    const editDescription = document.getElementById('editDescription');

    function hideEditModal() {
      if (!editModal) return;
      editModal.classList.add('opacity-0', 'pointer-events-none');
      editModal.querySelector('.admin-card').classList.remove('scale-100');
      editModal.querySelector('.admin-card').classList.add('scale-95');
    }

    if (closeBtn) closeBtn.addEventListener('click', hideEditModal);
    if (cancelBtn) cancelBtn.addEventListener('click', hideEditModal);
    if (editModal) {
      editModal.addEventListener('click', (e) => {
        if (e.target === editModal) hideEditModal();
      });
    }

    document.querySelectorAll('.btn-edit-product').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        editForm.action = `/admin/products/edit/${id}`;
        editTitle.value = btn.dataset.title || '';
        const currentCat = btn.dataset.category || '';
        editPrice.value = btn.dataset.price || '';
        editDescription.value = btn.dataset.description || '';

        // Select the matching category option
        for (let opt of editCatSelect.options) {
          if (opt.value.toLowerCase() === currentCat.toLowerCase()) {
            opt.selected = true;
            break;
          }
        }

        editModal.classList.remove('opacity-0', 'pointer-events-none');
        editModal.querySelector('.admin-card').classList.remove('scale-95');
        editModal.querySelector('.admin-card').classList.add('scale-100');
      });
    });

    // In-website luxury confirmation for category deletion (Zero native browser alerts/confirms)
    document.querySelectorAll('.btn-delete-category').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const catId = btn.dataset.id;
        const catName = btn.dataset.name;
        const form = document.getElementById('delete-cat-form-' + catId);
        if (!form) return;

        if (typeof window.showLuxuryConfirm === 'function') {
          window.showLuxuryConfirm(
            'Remove Category?',
            `Are you sure you want to remove category "${catName}"? Products in this category will keep their attributes.`,
            'Remove Category',
            async () => {
              try {
                const res = await fetch(`/admin/categories/delete/${catId}`, {
                  method: 'POST',
                  headers: { 'Accept': 'application/json' }
                });
                if (res.status === 401) {
                  const json = await res.json();
                  window.location.href = json.redirect || '/auth/login';
                  return;
                }
                const data = await res.json();
                if (data.success) {
                  const pill = btn.closest('.admin-pill');
                  if (pill) {
                    pill.style.transition = 'all 0.3s ease';
                    pill.style.opacity = '0';
                    pill.style.transform = 'scale(0.8)';
                    setTimeout(() => pill.remove(), 300);
                  }
                  if (window.showLuxuryToast) {
                    window.showLuxuryToast('Category Removed', `"${catName}" has been removed.`);
                  }
                } else {
                  form.submit();
                }
              } catch (err) {
                form.submit();
              }
            }
          );
        } else {
          form.submit();
        }
      });
    });

    // In-website luxury confirmation for product deletion (Zero native browser alerts/confirms)
    document.querySelectorAll('.btn-delete-product').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const prodId = btn.dataset.id;
        const prodTitle = btn.dataset.title || 'this creation';
        const form = document.getElementById('delete-product-form-' + prodId);
        if (!form) return;

        if (typeof window.showLuxuryConfirm === 'function') {
          window.showLuxuryConfirm(
            'Delete Boutique Creation?',
            `Are you sure you want to permanently delete "${prodTitle}"? This action cannot be reversed.`,
            'Delete Permanently',
            () => form.submit()
          );
        } else {
          form.submit();
        }
      });
    });

    // Smooth Add Category handling with in-website toast notification
    const addCatForm = document.getElementById('addCategoryForm');
    if (addCatForm) {
      addCatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('newCategoryInput');
        const name = (input ? input.value : '').trim();
        if (!name) return;

        try {
          const res = await fetch('/admin/categories/add', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'Accept': 'application/json'
            },
            body: new URLSearchParams({ name })
          });
          if (res.status === 401) {
            const json = await res.json();
            window.location.href = json.redirect || '/auth/login';
            return;
          }
          const data = await res.json();
          if (data.success) {
            if (input) input.value = '';
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Category Added', `Category "${name}" added successfully.`);
            }
            setTimeout(() => {
              window.location.reload();
            }, 600);
          } else {
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Notice', data.error || 'Could not add category.', true);
            }
          }
        } catch (err) {
          addCatForm.submit();
        }
      });
    }
  });
</script>

<!-- Promotional Coupon AJAX Management with In-Website Popup Figures -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const addCouponForm = document.getElementById('addCouponForm');
    const newCouponInput = document.getElementById('newCouponInput');
    const couponsContainer = document.getElementById('couponsChipsContainer');

    function createCouponChipElement(id, code) {
      const chip = document.createElement('div');
      chip.className = 'coupon-chip inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 shadow-2xs group transition hover:border-purple-400';
      chip.setAttribute('data-coupon-id', id);
      chip.innerHTML = `
        <span class="font-mono font-bold text-xs text-purple-950 dark:text-purple-200 tracking-wider">
          ${code}
        </span>
        <span class="text-[9px] uppercase font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">
          Free Delivery
        </span>
        <button
          type="button"
          class="btn-delete-coupon text-stone-400 hover:text-rose-600 transition text-xs font-bold p-0.5 rounded hover:bg-rose-50 dark:hover:bg-rose-950/50"
          data-id="${id}"
          data-code="${code}"
          title="Remove coupon code"
        >
          &times;
        </button>
      `;
      return chip;
    }

    // Add coupon via AJAX (no alert, no signout)
    if (addCouponForm) {
      addCouponForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = (newCouponInput ? newCouponInput.value : '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');
        if (!code) {
          if (window.showLuxuryToast) window.showLuxuryToast('Notice', 'Please type a valid coupon code.', true);
          return;
        }

        try {
          const res = await fetch('/admin/coupons/add', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'Accept': 'application/json'
            },
            body: new URLSearchParams({ code })
          });

          if (res.status === 401) {
            if (window.showLuxuryToast) window.showLuxuryToast('Authentication', 'Session expired. Please sign in.', true);
            setTimeout(() => window.location.href = '/auth/login?redirect=' + encodeURIComponent('/admin#coupons-section'), 1000);
            return;
          }

          const data = await res.json();
          if (data.success) {
            if (newCouponInput) newCouponInput.value = '';

            // Remove empty notice if present
            const emptyNotice = document.getElementById('noCouponsNotice');
            if (emptyNotice) emptyNotice.remove();

            // Append new coupon chip
            const newChip = createCouponChipElement(data.id || Date.now(), data.code);
            couponsContainer.appendChild(newChip);

            if (window.showLuxuryToast) {
              window.showLuxuryToast('Coupon Activated', `Coupon "${data.code}" is active for free delivery.`);
            }
          } else {
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Notice', data.error || 'Could not add coupon code.', true);
            }
          }
        } catch (err) {
          if (window.showLuxuryToast) {
            window.showLuxuryToast('Error', 'Network error. Please try again.', true);
          }
        }
      });
    }

    // Delete coupon with Luxury Confirmation Popup Figure (zero browser alert/confirm)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-delete-coupon');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const couponId = btn.getAttribute('data-id');
      const couponCode = btn.getAttribute('data-code') || 'this coupon';
      const chip = btn.closest('.coupon-chip');

      const doDelete = async () => {
        try {
          const res = await fetch(`/admin/coupons/delete/${couponId}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json' }
          });

          if (res.status === 401) {
            if (window.showLuxuryToast) window.showLuxuryToast('Authentication', 'Session expired. Please sign in.', true);
            setTimeout(() => window.location.href = '/auth/login?redirect=' + encodeURIComponent('/admin#coupons-section'), 1000);
            return;
          }

          const data = await res.json();
          if (data.success) {
            if (chip) {
              chip.style.transition = 'all 0.25s ease';
              chip.style.opacity = '0';
              chip.style.transform = 'scale(0.8)';
              setTimeout(() => {
                chip.remove();
                if (couponsContainer && !couponsContainer.querySelector('.coupon-chip')) {
                  couponsContainer.innerHTML = `
                    <div id="noCouponsNotice" class="p-4 rounded-xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700 text-center text-xs text-stone-500 w-full">
                      No coupon codes active yet. Type a code above (like <strong class="font-mono text-purple-700 dark:text-purple-300">FREESHIP</strong>) and click <strong>Add Coupon</strong> to grant customers free delivery.
                    </div>
                  `;
                }
              }, 250);
            }
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Coupon Removed', `Coupon "${couponCode}" has been removed.`);
            }
          } else {
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Error', 'Could not delete coupon.', true);
            }
          }
        } catch (err) {
          if (window.showLuxuryToast) {
            window.showLuxuryToast('Error', 'Network error. Please try again.', true);
          }
        }
      };

      if (typeof window.showLuxuryConfirm === 'function') {
        window.showLuxuryConfirm(
          'Remove Coupon?',
          `Are you sure you want to remove promotional code "${couponCode}"? Customers will no longer receive free delivery with this code.`,
          'Delete Coupon',
          doDelete
        );
      } else {
        doDelete();
      }
    });
  });
</script>

<!-- Customer Search, 3-Dot Menu & Delete User Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ═══════════════════════════════════════════
    // 1. CUSTOMER SEARCH (Live search with debounce)
    // ═══════════════════════════════════════════
    const searchInput = document.getElementById('customerSearchInput');
    const searchClear = document.getElementById('customerSearchClear');
    const searchResults = document.getElementById('customerSearchResults');
    const defaultContent = document.getElementById('customersDefaultContent');
    let searchTimer = null;

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function renderSearchResults(users) {
      if (!users.length) {
        searchResults.innerHTML = `
          <div class="p-6 text-center text-xs text-stone-500 font-medium admin-subtext">
            <svg class="w-8 h-8 mx-auto mb-2 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            No customers found matching your search.
          </div>`;
        return;
      }

      const html = users.map(u => `
        <div class="admin-mobile-customer-card p-3.5 flex items-center gap-3 hover:bg-purple-50/40 transition search-result-row" data-user-id="${u.id}">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center text-purple-900 font-bold text-sm shrink-0 border border-purple-200 shadow-sm">
            ${escapeHtml(u.name ? u.name.charAt(0).toUpperCase() : '?')}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-stone-900 text-xs admin-heading truncate">${escapeHtml(u.name)}</span>
              <div class="relative shrink-0">
                <button type="button" class="user-dots-btn w-7 h-7 rounded-full hover:bg-stone-100 flex items-center justify-center transition admin-dots-btn" data-user-id="${u.id}" data-user-name="${escapeHtml(u.name)}">
                  <svg class="w-4 h-4 text-stone-500" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="4" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="10" cy="16" r="1.5"/></svg>
                </button>
                <div class="user-dots-menu hidden absolute right-0 top-full mt-1 w-40 bg-white rounded-xl border border-stone-200 shadow-xl z-30 overflow-hidden admin-dropdown-menu" data-menu-for="${u.id}">
                  <button type="button" class="btn-delete-user w-full text-left px-4 py-2.5 text-xs font-bold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition" data-user-id="${u.id}" data-user-name="${escapeHtml(u.name)}">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Delete Customer
                  </button>
                </div>
              </div>
            </div>
            <span class="text-[11px] text-stone-600 font-mono block truncate mt-0.5">${escapeHtml(u.email)}</span>
            <div class="flex items-center justify-between mt-0.5">
              <span class="text-[10px] text-stone-400 font-mono">#${u.id}</span>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-stone-100 text-stone-700 border border-stone-200 admin-pill">${escapeHtml(u.role)}</span>
            </div>
          </div>
        </div>
      `).join('');

      searchResults.innerHTML = `
        <div class="text-[10px] font-bold uppercase tracking-wider text-stone-500 mb-2 px-1">${users.length} result${users.length !== 1 ? 's' : ''} found</div>
        <div class="divide-y divide-stone-200 rounded-xl border border-stone-200 overflow-hidden admin-card" style="box-shadow: none !important;">
          ${html}
        </div>`;

      // Re-attach event listeners for dynamically rendered elements
      attachDotsListeners(searchResults);
      attachDeleteListeners(searchResults);
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim();
        if (searchClear) searchClear.classList.toggle('hidden', !q);

        if (searchTimer) clearTimeout(searchTimer);

        if (!q) {
          searchResults.classList.add('hidden');
          searchResults.innerHTML = '';
          if (defaultContent) defaultContent.classList.remove('hidden');
          return;
        }

        searchTimer = setTimeout(async () => {
          try {
            const res = await fetch(`/admin/users/search?q=${encodeURIComponent(q)}`, {
              headers: { 'Accept': 'application/json' }
            });
            if (res.status === 401) {
              window.location.href = '/auth/login';
              return;
            }
            const data = await res.json();
            if (data.success) {
              if (defaultContent) defaultContent.classList.add('hidden');
              searchResults.classList.remove('hidden');
              renderSearchResults(data.users);
            }
          } catch (err) {
            console.error('Search error:', err);
          }
        }, 300);
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchClear.classList.add('hidden');
        searchResults.classList.add('hidden');
        searchResults.innerHTML = '';
        if (defaultContent) defaultContent.classList.remove('hidden');
        searchInput.focus();
      });
    }

    // ═══════════════════════════════════════════
    // 2. THREE-DOT DROPDOWN MENU LOGIC
    // ═══════════════════════════════════════════
    function closeAllDotMenus() {
      document.querySelectorAll('.user-dots-menu').forEach(m => m.classList.add('hidden'));
    }

    function attachDotsListeners(container) {
      (container || document).querySelectorAll('.user-dots-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const userId = btn.dataset.userId;
          const menu = (container || document).querySelector(`.user-dots-menu[data-menu-for="${userId}"]`);
          if (!menu) return;

          // If this menu is already open, just close it
          const isOpen = !menu.classList.contains('hidden');
          closeAllDotMenus();
          if (!isOpen) {
            menu.classList.remove('hidden');
          }
        });
      });
    }

    // Close menus when clicking anywhere outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.user-dots-btn') && !e.target.closest('.user-dots-menu')) {
        closeAllDotMenus();
      }
    });

    // Attach to static elements
    attachDotsListeners(document);

    // ═══════════════════════════════════════════
    // 3. DELETE CUSTOMER (with luxury confirm)
    // ═══════════════════════════════════════════
    function handleDeleteUser(userId, userName, rowEl) {
      const doDelete = async () => {
        try {
          const res = await fetch(`/admin/users/delete/${userId}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json' }
          });
          if (res.status === 401) {
            const json = await res.json();
            window.location.href = json.redirect || '/auth/login';
            return;
          }
          const data = await res.json();
          if (data.success) {
            // Animate removal
            if (rowEl) {
              rowEl.style.transition = 'all 0.3s ease';
              rowEl.style.opacity = '0';
              rowEl.style.transform = 'translateX(-20px)';
              setTimeout(() => rowEl.remove(), 300);
            }
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Customer Deleted', `"${userName}" has been removed.`);
            }
          } else {
            if (window.showLuxuryToast) {
              window.showLuxuryToast('Error', 'Could not delete customer.', true);
            }
          }
        } catch (err) {
          if (window.showLuxuryToast) {
            window.showLuxuryToast('Error', 'Network error. Please try again.', true);
          }
        }
      };

      closeAllDotMenus();

      if (typeof window.showLuxuryConfirm === 'function') {
        window.showLuxuryConfirm(
          'Delete Customer Account?',
          `Are you sure you want to permanently delete "${userName}"? All their data will be removed. This cannot be undone.`,
          'Delete Customer',
          doDelete
        );
      } else {
        doDelete();
      }
    }

    function attachDeleteListeners(container) {
      (container || document).querySelectorAll('.btn-delete-user').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const userId = btn.dataset.userId;
          const userName = btn.dataset.userName || 'this customer';
          // Find the closest row/card
          const row = btn.closest('[data-user-id]') || btn.closest('tr') || btn.closest('.admin-mobile-customer-card') || btn.closest('.search-result-row');
          handleDeleteUser(userId, userName, row);
        });
      });
    }

    // Attach to static elements
    attachDeleteListeners(document);
  });
</script>

