<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-screen">

  <!-- Breadcrumbs -->
  <nav class="flex items-center text-xs text-stone-600 mb-8 space-x-2">
    <a href="/" class="hover:text-stone-900 transition flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Home
    </a>
    <span>/</span>
    <a href="/#featured" class="hover:text-stone-900 transition">Boutique Creations</a>
    <span>/</span>
    <span class="text-stone-700 font-medium truncate max-w-[200px] sm:max-w-none"><%= product.title %></span>
  </nav>

  <!-- Product Detail Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

    <!-- Left: Gallery & Visuals -->
    <div class="space-y-4">
      <div class="relative aspect-[3/4] rounded-2xl overflow-hidden bg-stone-100 shadow-2xl border border-stone-200/80 group">
        <img
          id="mainProductImage"
          src="<%= product.image_url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1200&q=85' %>"
          alt="<%= product.title %>"
          class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
        >
        <!-- Luxury Badges -->
        <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none">
          <span class="glass-strong px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-widest text-brand-dark shadow-sm">
            Haute Couture
          </span>
          <span class="bg-black/60 backdrop-blur-md text-white px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider">
            SKU: BNM-00<%= product.id %>
          </span>
        </div>

        <div class="absolute bottom-4 right-4 glass-strong px-3 py-1.5 rounded-full text-xs text-stone-700 flex items-center gap-1.5 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Ready to Ship
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="grid grid-cols-3 gap-2.5 pt-2">
        <div class="p-3 rounded-xl bg-stone-50 border border-stone-200/60 text-center">
          <svg class="w-5 h-5 mx-auto mb-1 text-purple-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span class="block text-[10px] font-bold text-stone-800 uppercase tracking-wider">100% Certified</span>
          <span class="text-[9px] text-stone-600">Pure Artisan Silk</span>
        </div>
        <div class="p-3 rounded-xl bg-stone-50 border border-stone-200/60 text-center">
          <svg class="w-5 h-5 mx-auto mb-1 text-purple-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="block text-[10px] font-bold text-stone-800 uppercase tracking-wider">Dispatched</span>
          <span class="text-[9px] text-stone-600">Within 24 Hours</span>
        </div>
        <div class="p-3 rounded-xl bg-stone-50 border border-stone-200/60 text-center">
          <svg class="w-5 h-5 mx-auto mb-1 text-purple-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span class="block text-[10px] font-bold text-stone-800 uppercase tracking-wider">Gift Boxed</span>
          <span class="text-[9px] text-stone-600">Imperial Packaging</span>
        </div>
      </div>
    </div>

    <!-- Right: Product Information & Purchase -->
    <div class="flex flex-col justify-between space-y-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="text-[11px] uppercase tracking-[0.25em] text-brand-plum font-semibold">
            Bespoke Collection
          </span>
          <span class="text-stone-300">•</span>
          <span class="text-xs text-amber-500 flex items-center gap-1">
            ★★★★★ <span class="text-stone-600 text-[10px] font-medium">(28 bespoke reviews)</span>
          </span>
        </div>

        <h1 class="font-heading text-3xl sm:text-4xl text-brand-dark font-medium tracking-tight mb-3">
          <%= product.title %>
        </h1>

        <!-- Price -->
        <div class="flex items-baseline gap-3 mb-6">
          <span class="font-heading text-3xl sm:text-4xl font-bold text-brand-dark">
            ৳<%= Number(product.price).toLocaleString() %>
          </span>
          <span class="text-xs text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded font-medium">
            Taxes & Insured Courier Included
          </span>
        </div>

        <!-- Description -->
        <div class="prose prose-stone text-stone-600 text-sm leading-relaxed mb-6">
          <p class="mb-3">
            <%= product.description %>
          </p>
          <p class="text-xs text-stone-700 leading-normal">
            Impeccably woven on handlooms passed down through generational heritage, this bespoke creation synthesizes majestic imperial drapery with contemporary haute couture precision. Every seam reflects hours of delicate handcraft.
          </p>
        </div>

        <!-- Specifications Accordion/Table -->
        <div class="border-y border-stone-200 py-4 space-y-3 mb-6 text-xs">
          <div class="flex justify-between py-1 border-b border-stone-100">
            <span class="text-stone-600 font-medium">Material & Weave</span>
            <span class="text-brand-dark font-semibold">100% Grade-A Mulberry Silk & Real Zari</span>
          </div>
          <div class="flex justify-between py-1 border-b border-stone-100">
            <span class="text-stone-600 font-medium">Artisan Provenance</span>
            <span class="text-brand-dark font-semibold">Master Weavers Guild, Bunonmela Atelier</span>
          </div>
          <div class="flex justify-between py-1 border-b border-stone-100">
            <span class="text-stone-600 font-medium">Care Recommendation</span>
            <span class="text-brand-dark font-semibold">Dry Clean Only • Store in breathable muslin</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-stone-600 font-medium">Custom Tailoring</span>
            <span class="text-brand-dark font-semibold">Complimentary blouse stitching available</span>
          </div>
        </div>

        <!-- Purchase Actions Section -->
        <div class="space-y-4 pt-2">
          
          <!-- Quantity Selector -->
          <div class="flex items-center gap-4">
            <span class="text-xs font-semibold text-stone-700 uppercase tracking-wider">Quantity:</span>
            <div class="flex items-center border border-stone-300 rounded-full bg-stone-50 px-2 py-1">
              <button type="button" id="qtyMinus" class="w-7 h-7 rounded-full flex items-center justify-center text-stone-600 hover:bg-stone-200 transition text-base font-bold">-</button>
              <input type="number" id="qtyInput" value="1" min="1" max="10" class="w-12 text-center bg-transparent border-none text-sm font-semibold text-brand-dark focus:outline-none" readonly>
              <button type="button" id="qtyPlus" class="w-7 h-7 rounded-full flex items-center justify-center text-stone-600 hover:bg-stone-200 transition text-base font-bold">+</button>
            </div>
          </div>

          <!-- Buttons: Add to Cart & Buy Now -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <!-- Add to Cart -->
            <button
              type="button"
              id="btnAddToCart"
              data-product-id="<%= product.id %>"
              class="btn-liquid w-full justify-center py-3.5 text-sm font-semibold shadow-md flex items-center gap-2"
              style="background: #ffffff; color: #3B0764; border: 1.5px solid rgba(59,7,100,0.3);"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
              <span>Add to Cart</span>
            </button>

            <!-- Buy Now -->
            <button
              type="button"
              id="btnBuyNow"
              data-product-id="<%= product.id %>"
              class="btn-liquid w-full justify-center py-3.5 text-sm font-semibold shadow-lg flex items-center gap-2 text-white"
              style="background: linear-gradient(135deg, #3B0764 0%, #7E22CE 100%);"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>Buy Now</span>
            </button>
          </div>

        </div>

      </div>

      <!-- Security / Guarantees -->
      <div class="p-4 rounded-xl bg-stone-50 border border-stone-200/60 flex items-center justify-between text-xs text-stone-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>Encrypted Checkout with SQLite Security</span>
        </div>
        <span>30-Day Bespoke Returns</span>
      </div>

    </div>

  </div>

  <!-- Related Curated Pieces -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="mt-24 pt-12 border-t border-stone-200">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-brand-plum font-semibold block mb-1">Companion Creations</span>
          <h2 class="font-heading text-2xl font-medium text-brand-dark">You May Also Admire</h2>
        </div>
        <a href="/#featured" class="text-xs font-semibold text-brand-plum hover:underline">View All Creations &rarr;</a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
        <% relatedProducts.forEach(function(rel) { %>
          <a href="/products/<%= rel.id %>" class="group glass rounded-xl overflow-hidden card-lift hover:shadow-luxury-hover flex flex-col">
            <div class="aspect-[3/4] bg-stone-100 overflow-hidden relative">
              <img src="<%= rel.image_url %>" alt="<%= rel.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              <span class="absolute top-2 left-2 glass-strong text-[9px] font-bold px-2 py-0.5 rounded text-brand-dark">#<%= rel.id %></span>
            </div>
            <div class="p-3 sm:p-4">
              <h3 class="font-heading text-sm font-medium text-brand-dark group-hover:text-brand-plum transition truncate"><%= rel.title %></h3>
              <div class="mt-1 flex items-center justify-between">
                <span class="text-sm font-bold text-brand-dark">৳<%= Number(rel.price).toLocaleString() %></span>
                <span class="text-[11px] text-brand-plum font-medium">Explore &rarr;</span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>

</main>

<!-- Authentication Required Modal (for unauthenticated users clicking Add to Cart / Buy Now) -->
<div id="authRequiredModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="auth-card w-full max-w-md p-6 sm:p-8 transform scale-95 transition-transform duration-300 relative bg-white rounded-2xl shadow-2xl">
    <button type="button" id="closeAuthModal" class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 text-lg w-8 h-8 rounded-full flex items-center justify-center bg-stone-100">
      &times;
    </button>

    <div class="text-center mb-5">
      <span class="w-12 h-12 rounded-full bg-purple-100 text-purple-900 flex items-center justify-center mx-auto mb-3 shadow-inner">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </span>
      <h3 class="font-heading text-xl font-bold text-brand-dark">Sign In to Continue</h3>
      <p class="text-xs text-stone-500 mt-1">
        Please sign in with your email & password or create an account to add items to your cart and complete your purchase.
      </p>
    </div>

    <!-- Quick Sign In Form -->
    <form action="/auth/login" method="POST" class="space-y-3.5">
      <input type="hidden" name="redirect" id="modalRedirect" value="/products/<%= product.id %>">
      <input type="hidden" name="action" id="modalAction" value="add_cart">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <input type="hidden" name="quantity" id="modalQuantity" value="1">

      <div>
        <label class="block text-[10px] uppercase font-bold text-stone-500 tracking-wider mb-1">Email Address</label>
        <input name="email" type="email" required placeholder="you@example.com" class="input-luxury text-sm">
      </div>
      <div>
        <label class="block text-[10px] uppercase font-bold text-stone-500 tracking-wider mb-1">Password</label>
        <input name="password" type="password" required placeholder="••••••••" class="input-luxury text-sm">
      </div>
      <button type="submit" class="btn-liquid w-full justify-center py-3 text-sm font-semibold" style="background: #3B0764; color: #fff;">
        Sign In & Add to Cart
      </button>
    </form>

    <div class="mt-4 pt-4 border-t border-stone-100 text-center">
      <p class="text-xs text-stone-500">
        New to Bunonmela? 
        <a id="modalSignupLink" href="/auth/signup?redirect=<%= encodeURIComponent('/products/' + product.id) %>&action=add_cart&productId=<%= product.id %>" class="text-brand-plum font-bold hover:underline">
          Create Account
        </a>
      </p>
    </div>
  </div>
</div>

<!-- Toast notification element -->
<div id="cartToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
  <div class="glass-strong bg-white/95 border border-purple-200/90 text-brand-dark px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3">
    <div class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <div>
      <h4 class="text-xs font-bold text-brand-dark" id="toastTitle">Added to Shopping Bag</h4>
      <p class="text-[11px] text-stone-500" id="toastMsg"><%= product.title %> has been reserved.</p>
    </div>
    <a href="/cart" class="btn-liquid btn-liquid-sm ml-2 text-xs" style="background:#3B0764;color:#fff;">View Bag</a>
  </div>
</div>

<script>
  window.isUserLoggedIn = <%= currentUser ? 'true' : 'false' %>;
  window.currentProductId = <%= product.id %>;
</script>

<script src="/js/product-detail.js"></script>

<%- include('partials/footer') %>
