<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="pt-32 pb-24 px-4 sm:px-6 max-w-lg mx-auto min-h-screen text-center">
  <div class="glass rounded-3xl p-8 sm:p-10 border border-stone-200/80 shadow-2xl animate-fade-in">
    <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-5 shadow-inner">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>

    <span class="text-[10px] uppercase tracking-[0.3em] text-brand-plum font-bold block mb-1">Couture Confirmation</span>
    <h1 class="font-heading text-2xl sm:text-3xl font-bold text-brand-dark mb-3">Order Confirmed</h1>

    <p class="text-xs text-stone-500 mb-6 leading-relaxed">
      Thank you, <strong class="text-stone-800"><%= userName %></strong>. Your bespoke order has been placed into atelier preparation.
    </p>

    <div class="p-4 rounded-xl bg-stone-50 border border-stone-200/80 mb-6 text-left space-y-2 text-xs">
      <div class="flex justify-between">
        <span class="text-stone-500">Order Reference:</span>
        <span class="font-mono font-bold text-brand-dark"><%= orderNumber %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-stone-500">Delivery Status:</span>
        <span class="font-semibold text-emerald-600">Insured Atelier Courier</span>
      </div>
      <div class="flex justify-between">
        <span class="text-stone-500">Estimated Dispatch:</span>
        <span class="font-medium text-stone-700">Within 24 Hours</span>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn-liquid justify-center text-xs" style="background:#3B0764;color:#fff;">
        Return to Storefront
      </a>
      <a href="/#featured" class="btn-liquid justify-center text-xs">
        Browse More Pieces
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
