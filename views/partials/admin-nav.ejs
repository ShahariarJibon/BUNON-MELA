<!-- ═══════════════════════════════════════════
     DYNAMIC MOVING CAPSULE LOGIC & ZERO-LAG SCROLL SPY
     ═══════════════════════════════════════════ -->
<script>
  (function() {
    // 1. Dark / Light Theme handling
    const htmlEl = document.documentElement;
    const bodyEl = document.body;

    function applyAdminTheme(theme) {
      const thumb = document.getElementById('modeThumb');
      const sunIcon = document.getElementById('thumbSunIcon');
      const moonIcon = document.getElementById('thumbMoonIcon');

      if (theme === 'dark') {
        htmlEl.classList.add('dark');
        bodyEl.classList.add('admin-dark');
        if (thumb) {
          thumb.style.transform = 'translateX(28px)';
          thumb.style.backgroundColor = '#18181b';
        }
        if (sunIcon) sunIcon.classList.add('hidden');
        if (moonIcon) moonIcon.classList.remove('hidden');
      } else {
        htmlEl.classList.remove('dark');
        bodyEl.classList.remove('admin-dark');
        if (thumb) {
          thumb.style.transform = 'translateX(0px)';
          thumb.style.backgroundColor = '#ffffff';
        }
        if (sunIcon) sunIcon.classList.remove('hidden');
        if (moonIcon) moonIcon.classList.add('hidden');
      }
    }

    const savedTheme = localStorage.getItem('bunonmela_admin_theme') || 'light';
    applyAdminTheme(savedTheme);

    document.addEventListener('DOMContentLoaded', () => {
      applyAdminTheme(localStorage.getItem('bunonmela_admin_theme') || 'light');
      
      const toggleBtn = document.getElementById('adminThemeToggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const current = localStorage.getItem('bunonmela_admin_theme') || 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          localStorage.setItem('bunonmela_admin_theme', next);
          applyAdminTheme(next);
        });
      }

      // ═══════════════════════════════════════════
      // 2. BUTTERY-SMOOTH CAPSULE TRACKER (120fps GPU-only)
      // Uses translate3d for composited-layer animation, no layout thrashing
      // ═══════════════════════════════════════════
      const CAPSULE_TRANSITION = 'transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), height 0.2s ease, opacity 0.15s ease';

      function setupCapsuleTracker(containerId, thumbId, itemSelector) {
        const container = document.getElementById(containerId);
        const thumb = document.getElementById(thumbId);
        if (!container || !thumb) return null;

        const items = container.querySelectorAll(itemSelector);
        if (!items.length) return null;

        let activeItem = container.querySelector(itemSelector + '.is-active') || items[0];
        let rafId = null;

        function moveCapsuleTo(targetItem, animate = true) {
          if (!targetItem || targetItem === activeItem && thumb.style.opacity === '1') return;
          activeItem = targetItem;

          // Update active classes
          items.forEach(el => el.classList.remove('is-active'));
          targetItem.classList.add('is-active');

          // Cancel any pending rAF to prevent stacking
          if (rafId) cancelAnimationFrame(rafId);

          rafId = requestAnimationFrame(() => {
            // Single layout read — batched
            const cRect = container.getBoundingClientRect();
            const tRect = targetItem.getBoundingClientRect();

            const left = tRect.left - cRect.left;
            const top = tRect.top - cRect.top;
            const width = tRect.width;
            const height = tRect.height;

            // Single write phase — all style mutations together
            thumb.style.transition = animate ? CAPSULE_TRANSITION : 'none';
            thumb.style.transform = `translate3d(${left}px, ${top}px, 0)`;
            thumb.style.width = `${width}px`;
            thumb.style.height = `${height}px`;
            thumb.style.opacity = '1';
            rafId = null;
          });
        }

        // Initialize position on load (no animation)
        requestAnimationFrame(() => {
          moveCapsuleTo(activeItem, false);
        });

        // Click listeners on each option
        items.forEach(item => {
          item.addEventListener('click', (e) => {
            const targetId = item.getAttribute('data-target');
            if (targetId) {
              e.preventDefault();
              moveCapsuleTo(item, true);

              // Sync desktop <-> mobile
              if (containerId === 'adminNavSegmentContainer') {
                const mobileTarget = document.querySelector(`.admin-mobile-nav-item[data-target="${targetId}"]`);
                if (mobileTarget && window.moveMobileCapsule) window.moveMobileCapsule(mobileTarget);
              } else {
                const desktopTarget = document.querySelector(`.admin-nav-item[data-target="${targetId}"]`);
                if (desktopTarget && window.moveDesktopCapsule) window.moveDesktopCapsule(desktopTarget);
              }

              // Smooth scroll to destination with offset
              const targetEl = document.getElementById(targetId);
              if (targetEl) {
                const topOffset = targetEl.getBoundingClientRect().top + window.pageYOffset - 85;
                window.scrollTo({
                  top: Math.max(0, topOffset),
                  behavior: 'smooth'
                });
                history.replaceState(null, null, '#' + targetId);
              }
            }
          });
        });

        // Recalculate on window resize (debounced)
        let resizeTimer = null;
        window.addEventListener('resize', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (activeItem) moveCapsuleTo(activeItem, false);
          }, 100);
        });

        return { moveCapsuleTo, items };
      }

      // Initialize Desktop & Mobile Trackers
      const desktopTracker = setupCapsuleTracker('adminNavSegmentContainer', 'adminNavCapsuleThumb', '.admin-nav-item');
      const mobileTracker = setupCapsuleTracker('adminMobileSegmentContainer', 'adminMobileCapsuleThumb', '.admin-mobile-nav-item');

      if (desktopTracker) window.moveDesktopCapsule = desktopTracker.moveCapsuleTo;
      if (mobileTracker) window.moveMobileCapsule = mobileTracker.moveCapsuleTo;

      // ═══════════════════════════════════════════
      // 3. SCROLL SPY (Throttled with rAF — zero-jank)
      // Only fires once per frame, caches section offsets
      // ═══════════════════════════════════════════
      const sectionIds = [
        'dashboard-top',
        'orders-section',
        'categories-section',
        'products-section',
        'users-section'
      ];

      let scrollTicking = false;
      let lastKnownSection = 'dashboard-top';

      function updateScrollSpy() {
        const scrollY = window.pageYOffset + 140;
        let currentSectionId = 'dashboard-top';

        for (let i = 0; i < sectionIds.length; i++) {
          const el = document.getElementById(sectionIds[i]);
          if (el && scrollY >= el.offsetTop) {
            currentSectionId = sectionIds[i];
          }
        }

        // Only update if section actually changed
        if (currentSectionId !== lastKnownSection) {
          lastKnownSection = currentSectionId;

          const dItem = document.querySelector(`.admin-nav-item[data-target="${currentSectionId}"]`);
          if (dItem && !dItem.classList.contains('is-active') && desktopTracker) {
            desktopTracker.moveCapsuleTo(dItem, true);
          }

          const mItem = document.querySelector(`.admin-mobile-nav-item[data-target="${currentSectionId}"]`);
          if (mItem && !mItem.classList.contains('is-active') && mobileTracker) {
            mobileTracker.moveCapsuleTo(mItem, true);
          }
        }

        scrollTicking = false;
      }

      window.addEventListener('scroll', () => {
        if (!scrollTicking) {
          requestAnimationFrame(updateScrollSpy);
          scrollTicking = true;
        }
      }, { passive: true });

      // Handle initial hash in URL if present
      if (window.location.hash) {
        const hashTarget = window.location.hash.replace('#', '');
        const initialDItem = document.querySelector(`.admin-nav-item[data-target="${hashTarget}"]`);
        if (initialDItem && desktopTracker) {
          desktopTracker.moveCapsuleTo(initialDItem, false);
        }
        const initialMItem = document.querySelector(`.admin-mobile-nav-item[data-target="${hashTarget}"]`);
        if (initialMItem && mobileTracker) {
          mobileTracker.moveCapsuleTo(initialMItem, false);
        }
      }
    });
  })();
</script>
