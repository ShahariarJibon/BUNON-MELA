<!-- Admin Top Bar with Apple Liquid Glass Effect & Snappy Moving Capsule Segment -->
<header id="adminHeader" class="admin-topbar sticky top-0 z-40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 py-2.5 gap-4 lg:gap-8">
      
      <!-- Brand & Admin Badge with Apple Liquid Glass Touch -->
      <a href="/admin" class="flex items-center space-x-3 shrink-0 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600 to-brand-plum flex items-center justify-center text-amber-300 shrink-0 text-sm font-bold shadow-md shadow-purple-950/30 group-hover:scale-105 transition-transform duration-200">
          B
        </div>
        <div class="min-w-0 hidden sm:block">
          <span class="brand-logo-text block font-heading text-sm sm:text-base tracking-widest font-bold text-stone-900 dark:text-white transition-colors duration-200">BUNONMELA</span>
          <span class="block text-[9px] text-purple-700 dark:text-purple-300/90 tracking-wider uppercase font-semibold">Executive Atelier</span>
        </div>
      </a>

      <!-- Central Liquid Glass Capsule Segmented Controls (Evenly Separated Options) -->
      <nav class="hidden md:flex items-center justify-center flex-1 max-w-2xl mx-auto">
        <div id="adminNavSegmentContainer" class="admin-segment-track relative flex items-center p-1.5 rounded-full w-full justify-between gap-1 shadow-sm">
          
          <!-- Moving Apple Glass Capsule Thumb (Hardware-accelerated GPU 3D translation) -->
          <div
            id="adminNavCapsuleThumb"
            class="admin-capsule-thumb absolute rounded-full pointer-events-none opacity-0"
            style="top: 0; left: 0; will-change: transform, width;"
          ></div>

          <!-- 1. Dashboard -->
          <a
            href="#dashboard-top"
            data-target="dashboard-top"
            class="admin-nav-item is-active relative z-10 flex items-center justify-center gap-2 flex-1 px-4 py-2 rounded-full text-xs font-semibold transition-colors duration-150 select-none cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Dashboard</span>
          </a>

          <!-- 2. Orders -->
          <a
            href="#orders-section"
            data-target="orders-section"
            class="admin-nav-item relative z-10 flex items-center justify-center gap-2 flex-1 px-4 py-2 rounded-full text-xs font-semibold transition-colors duration-150 select-none cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span>Orders</span>
          </a>

          <!-- 3. Categories -->
          <a
            href="#categories-section"
            data-target="categories-section"
            class="admin-nav-item relative z-10 flex items-center justify-center gap-2 flex-1 px-4 py-2 rounded-full text-xs font-semibold transition-colors duration-150 select-none cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
            <span>Categories</span>
          </a>

          <!-- 4. Products -->
          <a
            href="#products-section"
            data-target="products-section"
            class="admin-nav-item relative z-10 flex items-center justify-center gap-2 flex-1 px-4 py-2 rounded-full text-xs font-semibold transition-colors duration-150 select-none cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <span>Products</span>
          </a>

          <!-- 5. Customers -->
          <a
            href="#users-section"
            data-target="users-section"
            class="admin-nav-item relative z-10 flex items-center justify-center gap-2 flex-1 px-4 py-2 rounded-full text-xs font-semibold transition-colors duration-150 select-none cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <span>Customers</span>
          </a>

        </div>
      </nav>

      <!-- Right Controls: Luxury Animated Mode Switcher & Admin Profile & Capsule Logout (Evenly Spaced) -->
      <div class="flex items-center space-x-3 sm:space-x-4 shrink-0">
        
        <!-- Stylish Mode Switcher (Liquid Glass Track & Sliding Glowing Thumb) -->
        <button
          id="adminThemeToggle"
          type="button"
          aria-label="Toggle dark and light mode"
          class="mode-switcher-btn relative rounded-full transition-all duration-300 flex items-center cursor-pointer focus:outline-none shrink-0"
          title="Switch Dark / Light Mode"
        >
          <!-- Background track icons (Stylish SVGs) -->
          <div class="w-full flex items-center justify-between px-1.5 pointer-events-none">
            <!-- Sleek Sun Icon on left -->
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" stroke-width="2" />
              <path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <!-- Sleek Moon & Star Icon on right -->
            <svg class="w-3.5 h-3.5 text-purple-300" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
            </svg>
          </div>

          <!-- Sliding Circle Thumb with Glowing Styled Icon -->
          <div
            id="modeThumb"
            class="absolute top-[2.5px] left-[2.5px] w-6 h-6 rounded-full bg-white shadow-md flex items-center justify-center transition-transform duration-300 transform pointer-events-none"
          >
            <!-- Sun Icon (in light mode) -->
            <svg id="thumbSunIcon" class="w-3.5 h-3.5 text-amber-500 transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" stroke-width="2" fill="currentColor" />
              <path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <!-- Moon Icon (in dark mode) -->
            <svg id="thumbMoonIcon" class="w-3.5 h-3.5 text-purple-400 hidden transition-opacity duration-200" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
            </svg>
          </div>
        </button>

        <!-- Admin Profile Pill (Apple Liquid Glass) -->
        <div class="admin-profile-pill flex items-center space-x-2 pl-2 pr-3.5 py-1.5 rounded-full text-xs shadow-sm">
          <div class="w-5 h-5 rounded-full bg-brand-plum flex items-center justify-center font-bold text-white text-[10px] shadow-sm">
            <%= (typeof adminUser !== 'undefined' && adminUser) ? adminUser.name.charAt(0).toUpperCase() : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser.name.charAt(0).toUpperCase() : 'A') %>
          </div>
          <span class="hidden sm:inline font-semibold text-stone-800 dark:text-stone-200 text-xs">
            <%= (typeof adminUser !== 'undefined' && adminUser) ? adminUser.name : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser.name : 'Admin') %>
          </span>
        </div>

        <!-- Logout Capsule Button with Apple Liquid Glass Border -->
        <a
          href="/auth/logout"
          class="admin-logout-capsule flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 shadow-sm"
          title="Sign out from executive atelier"
