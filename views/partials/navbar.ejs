<!-- RESADEX-style floating pill navbar -->
<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-5xl">
  <nav class="glass-strong rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between shadow-lg shadow-black/[0.04]">
    
    <!-- Brand Logo — always 1 line -->
    <a href="/" class="flex items-center min-w-0 shrink-0">
      <span class="brand-logo-text font-heading text-[14px] sm:text-lg font-bold tracking-[0.12em] sm:tracking-[0.18em] text-brand-dark">
        BUNONMELA
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center space-x-1">
      <a href="/" class="px-3 py-1.5 rounded-full text-xs font-bold tracking-wide text-stone-700 hover:text-brand-dark transition">Home</a>
      <a href="/#featured" class="px-3 py-1.5 rounded-full text-xs font-medium tracking-wide text-stone-600 hover:text-brand-dark transition">Collections</a>
      <a href="/#featured" class="px-3 py-1.5 rounded-full text-xs font-medium tracking-wide text-stone-600 hover:text-brand-dark transition">Catalog</a>
      <a href="/#story" class="px-3 py-1.5 rounded-full text-xs font-medium tracking-wide text-stone-600 hover:text-brand-dark transition">Atelier</a>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center space-x-2">
      <!-- Shopping Bag Button with Badge -->
      <a href="/cart" class="relative p-2 rounded-full text-stone-700 hover:bg-white/60 transition flex items-center justify-center" title="Shopping Bag">
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <span class="cart-badge absolute -top-0.5 -right-0.5 min-w-[17px] h-[17px] px-1 bg-brand-plum text-white rounded-full text-[9px] font-bold flex items-center justify-center shadow-sm">
          0
        </span>
      </a>

      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/profile" class="px-3 py-1.5 rounded-full text-[11px] font-semibold text-stone-700 hover:text-brand-plum hover:bg-white/60 transition hidden sm:inline-flex items-center gap-1.5" title="My Profile & Orders">
          <span class="w-4 h-4 rounded-full bg-purple-100 text-purple-900 flex items-center justify-center text-[9px] font-bold"><%= currentUser.name.charAt(0).toUpperCase() %></span>
          <span>Orders</span>
        </a>
        <% if (currentUser.role === 'admin' || (typeof adminUser !== 'undefined' && adminUser)) { %>
          <a href="/admin" class="btn-liquid btn-liquid-sm hidden sm:inline-flex">Admin</a>
        <% } %>
        <a href="/auth/logout" class="px-3 py-1.5 rounded-full text-[11px] font-medium text-stone-500 hover:text-rose-600 transition hidden sm:inline-flex">Logout</a>
      <% } else { %>
        <a href="/auth/login" class="btn-liquid btn-liquid-sm hidden sm:inline-flex">Sign In</a>
      <% } %>
      
      <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/profile' : '/auth/login' %>" class="px-3.5 py-1.5 bg-brand-dark text-white rounded-full text-[11px] font-bold tracking-wider transition hover:bg-brand-plum">
        <%= (typeof currentUser !== 'undefined' && currentUser) ? 'Account' : 'Join' %>
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobileMenuBtn" type="button" class="md:hidden p-1.5 rounded-full text-stone-600 hover:bg-white/60 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Drawer -->
  <div id="mobileMenu" class="hidden md:hidden mt-2 glass-strong rounded-2xl px-4 pt-3 pb-4 space-y-1 shadow-lg">
    <a href="/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-brand-dark bg-white/60">Home</a>
    <a href="/#featured" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-stone-600 hover:bg-white/40 transition">Collections</a>
    <a href="/cart" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-brand-plum bg-purple-50/60">
      <span>Shopping Bag</span>
      <span class="cart-badge bg-brand-plum text-white text-[10px] px-2 py-0.5 rounded-full font-bold">0</span>
    </a>
    <a href="/#story" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-stone-600 hover:bg-white/40 transition">About Atelier</a>
    <div class="pt-2 border-t border-stone-200/40 space-y-1">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/profile" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-brand-dark bg-purple-50/70">My Profile & Orders</a>
        <% if (currentUser.role === 'admin' || (typeof adminUser !== 'undefined' && adminUser)) { %>
          <a href="/admin" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-brand-plum">Admin Dashboard</a>
        <% } %>
        <a href="/auth/logout" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-stone-500">Logout (<%= currentUser.name %>)</a>
      <% } else { %>
        <a href="/auth/login" class="block px-3 py-2.5 rounded-lg text-sm font-bold text-brand-dark bg-brand-soft">Sign In</a>
        <a href="/auth/signup" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-stone-600">Create Account</a>
      <% } %>
    </div>
  </div>
</header>
