<%- include('../partials/header') %>

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-brand-soft via-white to-white">
  
  <div class="auth-card w-full max-w-sm p-6 sm:p-8 animate-fade-in">
    
    <!-- Brand with Logo -->
    <div class="text-center mb-6">
      <a href="/" class="inline-flex flex-col items-center group">
        <img src="/images/logo.jpeg" alt="Bunonmela Logo" class="w-14 h-14 rounded-full object-cover shadow-md border-2 border-purple-200 mb-2 group-hover:scale-105 transition-transform duration-300">
        <span class="font-heading text-xl tracking-[0.2em] font-bold text-brand-dark">BUNONMELA</span>
      </a>
      <p class="text-[10px] uppercase tracking-[0.2em] text-brand-accent/60 font-medium mt-0.5">Luxury Boutique</p>
    </div>

    <h2 class="font-heading text-xl font-medium text-brand-dark text-center mb-1">Create Account</h2>
    <p class="text-xs text-stone-400 text-center mb-6">Join with your mobile number — no email required</p>

    <% if (error) { %>
      <div class="mb-4 p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-600 text-xs"><%= error %></div>
    <% } %>

    <form action="/auth/signup" method="POST" class="space-y-4">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
      <input type="hidden" name="action" value="<%= typeof action !== 'undefined' ? action : '' %>">
      <input type="hidden" name="productId" value="<%= typeof productId !== 'undefined' ? productId : '' %>">
      <input type="hidden" name="quantity" value="<%= typeof quantity !== 'undefined' ? quantity : '1' %>">

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold mb-1">Full Name *</label>
        <input name="name" type="text" required autocomplete="name" class="input-luxury" placeholder="e.g. Eleanor Vance">
      </div>

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold mb-1">Mobile Number (BD) *</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-stone-400">+88</span>
          <input
            name="phone"
            type="tel"
            required
            pattern="^(?:\+88|88)?01[3-9]\d{8}$"
            maxlength="14"
            class="input-luxury pl-11"
            placeholder="017XXXXXXXX"
            title="11-digit Bangladeshi mobile number (013-019)"
          >
        </div>
        <span class="text-[10px] text-stone-400 mt-1 block">11-digit mobile (GP, Robi, Banglalink, Airtel, Teletalk).</span>
      </div>

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold mb-1">Email Address <span class="text-stone-400 font-normal lowercase">(optional)</span></label>
        <input name="email" type="email" autocomplete="email" class="input-luxury" placeholder="name@example.com (optional)">
      </div>

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold mb-1">Password *</label>
        <input name="password" type="password" required minlength="6" autocomplete="new-password" class="input-luxury" placeholder="Minimum 6 characters">
      </div>

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-stone-500 font-semibold mb-1">Confirm Password *</label>
        <input name="confirmPassword" type="password" required minlength="6" autocomplete="new-password" class="input-luxury" placeholder="Re-enter password">
      </div>

      <button type="submit" class="btn-liquid w-full justify-center" style="background:#3B0764;color:#fff;">
        Create Account & Continue
      </button>
    </form>

    <div class="mt-5 text-center">
      <p class="text-xs text-stone-400">
        Already have an account? 
        <a href="/auth/login?redirect=<%= encodeURIComponent(typeof redirect !== 'undefined' ? redirect : '') %>&action=<%= typeof action !== 'undefined' ? action : '' %>&productId=<%= typeof productId !== 'undefined' ? productId : '' %>&quantity=<%= typeof quantity !== 'undefined' ? quantity : '1' %>" class="text-brand-accent font-semibold hover:underline">Sign in</a>
      </p>
    </div>

  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
