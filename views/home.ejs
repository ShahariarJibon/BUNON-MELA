<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- ═══════════════════════════════════════════
     ANIMATED LUXURY WHITE SHADER HERO SECTION
     Fixed Ambient Motion · White Theme · Minimal Typography
     ═══════════════════════════════════════════ -->
<section class="shader-hero-container relative min-h-[85vh] sm:min-h-[92vh] bg-transparent overflow-hidden flex flex-col justify-center px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-16 z-10">

  <!-- Hero Main Content (Minimal Luxury Typography with Super Animations) -->
  <div class="relative z-20 max-w-4xl mx-auto w-full text-center sm:text-left py-8 sm:py-12">
    
    <!-- Minimalist Glass Badge (with floating breathing effect) -->
    <div class="inline-flex items-center px-4 py-1.5 rounded-full glass mb-6 border border-purple-200/90 shadow-sm animate-fade-in animate-float">
      <span class="w-2.5 h-2.5 rounded-full bg-brand-plum animate-ping mr-2.5"></span>
      <span class="text-[11px] uppercase tracking-[0.25em] text-brand-dark font-bold">
        Haute Couture Atelier • Bespoke 2026
      </span>
    </div>

    <!-- Minimal, Stunning Luxury Headline -->
    <h1 class="font-heading text-4xl sm:text-6xl lg:text-7xl font-light text-stone-900 mb-6 leading-[1.15] tracking-tight animate-fade-in-d1">
      <span class="block text-xl sm:text-3xl lg:text-4xl text-brand-plum font-normal italic tracking-wider mb-2">
        The Imperial Heritage of
      </span>
      <span class="block font-bold tracking-tight text-stone-900">
        Royal Silks & Jamdani Weaves
      </span>
      <span class="block font-light text-stone-600 italic text-2xl sm:text-4xl lg:text-5xl mt-2 animated-gradient-text">
        Woven for Timeless Elegance
      </span>
    </h1>

    <!-- Minimal Description -->
    <p class="text-sm sm:text-base font-light text-stone-600 mb-10 leading-relaxed max-w-2xl mx-auto sm:mx-0 animate-fade-in-d2">
      Handcrafted mulberry silk sarees, imperial jamdani ensembles, decorated boutique accessories, and bespoke couture created by master loom artisans. Where centuries of royal artistry meet contemporary sophistication.
    </p>

    <!-- Single Action Button: View Products (with smooth scroll down to catalog) -->
    <div class="flex items-center justify-center sm:justify-start gap-4 animate-fade-in-d2">
      <a
        href="#featured"
        id="heroViewProductsBtn"
        class="btn-liquid px-8 sm:px-10 py-3.5 sm:py-4 rounded-full text-xs sm:text-sm font-semibold tracking-wider uppercase flex items-center gap-2.5 shadow-xl text-white transition hover:scale-105"
        style="background: linear-gradient(135deg, #3B0764 0%, #7E22CE 100%);"
      >
        <span>View Products</span>
        <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- Bottom-Right Rotating Atelier Seal & Pulsing Gradient Orb -->
  <div class="absolute bottom-6 right-6 z-20 hidden md:block">
    <div class="relative w-24 h-24 flex items-center justify-center">
      
      <!-- Canvas for gentle luxury pulsing orb -->
      <canvas id="pulse-border-canvas" class="w-[68px] h-[68px] rounded-full shadow-md"></canvas>

      <!-- Rotating Text Around the Pulsing Border (0.3x speed) -->
      <svg
        class="absolute inset-0 w-full h-full rotating-circle-text pointer-events-none"
        viewBox="0 0 100 100"
      >
        <defs>
          <path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" />
        </defs>
        <text class="text-[9px] fill-stone-700 font-semibold uppercase tracking-[0.16em]">
          <textPath href="#circle" startOffset="0%">
            ✦ BUNONMELA ATELIER • ROYAL SILKS • HAUTE COUTURE ✦
          </textPath>
        </text>
      </svg>

    </div>
  </div>

</section>

<script>
  // Smooth scroll to catalog on clicking "View Products"
  document.getElementById('heroViewProductsBtn')?.addEventListener('click', function(e) {
    e.preventDefault();
    const target = document.getElementById('featured');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>


<!-- ═══════════════════════════════════════════
     PRODUCT CATALOG — Interactive Storefront with Category Filtering & Taka (৳)
     Translucent Background: Fixed Shader Background Visible Everywhere
     ═══════════════════════════════════════════ -->
<main class="flex-grow relative z-10 bg-white/75 backdrop-blur-md transition-colors">

  <!-- Section Header -->
  <section id="featured" class="pt-16 sm:pt-20 pb-12 sm:pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 sm:mb-12 gap-4">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-brand-plum font-semibold block mb-1">Curated Catalog</span>
          <h2 class="font-heading text-2xl sm:text-4xl text-brand-dark font-medium">Boutique Creations</h2>
          <p class="text-xs text-stone-500 mt-1">Select any piece to view complete specifications, artisan provenance, and order directly.</p>
        </div>

        <!-- Dynamic Category Filter Pills -->
        <div class="flex flex-wrap gap-1.5" id="categoryFilterBar">
          <button type="button" class="cat-filter-btn btn-liquid btn-liquid-sm active-cat" data-category="all" style="background:rgba(59,7,100,0.9);color:#fff;">All</button>
          <% ((typeof categories !== 'undefined' && categories) ? categories : []).forEach(function(cat) { %>
            <button type="button" class="cat-filter-btn btn-liquid btn-liquid-sm" data-category="<%= cat %>"><%= cat %></button>
          <% }); %>
        </div>
      </div>

      <% if (error) { %>
        <div class="mb-6 p-3 rounded-xl text-rose-600 text-sm bg-rose-50 border border-rose-200"><%= error %></div>
      <% } %>

      <% if (products && products.length > 0) { %>
        <!-- Grid of Super Animated Clickable Product Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="productsGrid">
          <% products.forEach(function(product) { %>
            
            <!-- Clickable Product Card Link (Super Animated) -->
            <a
              href="/products/<%= product.id %>"
              class="product-card group glass rounded-2xl overflow-hidden flex flex-col border border-stone-200/80 shadow-sm transition-all duration-500"
              data-category="<%= product.category || 'Decorated Bags' %>"
            >
              
              <!-- Image with Super Smooth Hover Zoom -->
              <div class="relative aspect-[3/4] bg-stone-100 overflow-hidden">
                <img 
                  src="<%= product.image_url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=800&q=80' %>"
                  alt="<%= product.title %>"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                >
                <div class="absolute top-2.5 left-2.5 glass-strong px-2 py-0.5 rounded text-[8px] sm:text-[9px] uppercase font-bold tracking-widest text-brand-dark shadow-sm">
                  #<%= product.id %>
                </div>
                <!-- Category Badge -->
                <div class="absolute bottom-2.5 left-2.5 glass-strong px-2.5 py-0.5 rounded-full text-[9px] font-bold text-brand-plum shadow-sm">
                  <%= product.category || 'Bespoke' %>
                </div>
                <button type="button" data-action="wishlist" data-title="<%= product.title %>" class="absolute top-2.5 right-2.5 w-7 h-7 sm:w-8 sm:h-8 rounded-full glass-strong text-stone-500 hover:text-brand-plum flex items-center justify-center transition hover:scale-110 shadow-sm" title="Add to Wishlist">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </button>
              </div>

              <!-- Details with Bangladeshi Taka (৳) -->
              <div class="p-3.5 sm:p-5 flex-grow flex flex-col justify-between space-y-3 bg-white/70">
                <div class="min-w-0">
                  <h3 class="font-heading text-sm sm:text-base font-semibold text-brand-dark group-hover:text-brand-plum transition truncate">
                    <%= product.title %>
                  </h3>
                  <p class="text-stone-500 text-[11px] sm:text-xs line-clamp-2 mt-1 leading-relaxed">
                    <%= product.description %>
                  </p>
                </div>
                
                <div class="flex items-end justify-between gap-2 pt-2.5 border-t border-stone-100">
                  <div class="flex flex-col justify-end">
                    <span class="text-[9px] text-stone-400 uppercase tracking-wider block mb-0.5">Price</span>
                    <span class="font-heading text-lg sm:text-xl font-bold text-brand-dark leading-none">
                      ৳<%= Number(product.price).toLocaleString() %>
                    </span>
                  </div>
                  
                  <span class="btn-liquid btn-liquid-sm group-hover:bg-purple-900 group-hover:text-white transition shrink-0 self-end">
                    <span>View Piece</span>
                    <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>

            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-12 glass rounded-2xl p-6">
          <h3 class="font-heading text-xl font-medium text-brand-dark mb-1">No Products Yet</h3>
          <p class="text-xs text-stone-400 mb-4">Catalog awaiting entries.</p>
          <a href="/admin" class="btn-liquid" style="background:#3B0764;color:#fff;">Open Admin</a>
        </div>
      <% } %>

    </div>
  </section>

  <!-- Heritage Story -->
  <section id="story" class="py-14 sm:py-24 bg-brand-dark/95 text-white relative overflow-hidden backdrop-blur-md">
    <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-brand-plum/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div class="space-y-5 text-center lg:text-left">
          <span class="text-[10px] uppercase tracking-[0.3em] text-brand-light font-semibold">Heritage</span>
          <h2 class="font-heading text-2xl sm:text-4xl font-normal leading-tight">
            Weaving Centuries of <br><span class="italic text-brand-light">Royal Elegance</span>
          </h2>
          <p class="text-stone-300 text-sm leading-relaxed font-light max-w-md mx-auto lg:mx-0">
            Bunonmela bridges master loom artisans with contemporary haute couture. Every thread is selected for its sensory richness and regal heritage.
          </p>
        </div>
        <div>
          <div class="relative rounded-2xl overflow-hidden border border-brand-plum/40 shadow-2xl max-w-md mx-auto lg:max-w-none">
            <img src="https://images.unsplash.com/photo-1544441893-675973e31985?auto=format&fit=crop&w=800&q=80" alt="Artisan weaving" class="w-full h-64 sm:h-80 object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent flex items-end p-4">
              <p class="text-[11px] text-brand-light/80 italic font-heading">"In every knot lies the whisper of imperial royalty."</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<script>
  // Dynamic Category Filtering
  document.querySelectorAll('.cat-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button styling
      document.querySelectorAll('.cat-filter-btn').forEach(b => {
        b.style.background = '';
        b.style.color = '';
      });
      btn.style.background = 'rgba(59,7,100,0.9)';
      btn.style.color = '#fff';

      const cat = btn.dataset.category.toLowerCase();
      const cards = document.querySelectorAll('.product-card');

      cards.forEach(card => {
        const itemCat = (card.dataset.category || '').toLowerCase();
        if (cat === 'all' || itemCat.includes(cat) || cat.includes(itemCat)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<%- include('partials/footer') %>
