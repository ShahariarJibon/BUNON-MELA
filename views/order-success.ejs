<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="pt-28 sm:pt-32 pb-24 px-4 sm:px-6 max-w-3xl mx-auto min-h-screen relative z-10">
  
  <!-- Popup Modal: Wait for Admin Confirmation -->
  <div id="orderSuccessModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-md transition-all duration-300">
    <div class="glass-strong bg-white/95 w-full max-w-md p-6 sm:p-8 rounded-3xl shadow-2xl border border-stone-200 text-center space-y-5 animate-scale-up">
      <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center mx-auto shadow-inner">
        <svg class="w-8 h-8 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <div>
        <span class="text-[10px] uppercase tracking-[0.25em] text-amber-800 font-bold block mb-1">Order Placed Successfully</span>
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-brand-dark">Wait for Admin Confirmation</h3>
        <p class="text-xs text-stone-600 mt-2 leading-relaxed">
          Thank you! Your order <span class="font-mono font-bold text-purple-900 bg-purple-50 px-2 py-0.5 rounded border border-purple-200">#<%= order.order_number %></span> has been received and is currently under <strong>'Pending'</strong> review.
        </p>
        <div class="mt-3 p-3 rounded-xl bg-amber-50 border border-amber-200/80 text-left text-xs text-amber-950 flex items-start gap-2.5">
          <span class="text-base shrink-0 mt-0.5">⏳</span>
          <p class="leading-relaxed text-[11px]">
            Please wait while the admin verifies your order and payment. When the admin approves your order, your status in <strong>Profile</strong> will show <strong class="text-emerald-700 font-bold">"Approved"</strong>. Till then it will remain <strong class="text-amber-700 font-bold">"Pending"</strong>.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5 pt-2">
        <a href="/profile" class="btn-liquid flex-1 justify-center text-xs py-3 font-semibold text-white shadow-md" style="background: linear-gradient(135deg, #3B0764 0%, #7E22CE 100%);">
          View in Profile
        </a>
        <button type="button" onclick="document.getElementById('orderSuccessModal').remove()" class="btn-liquid flex-1 justify-center text-xs py-3 font-semibold border border-stone-200 bg-stone-100 text-stone-700 hover:bg-stone-200 transition">
          View Receipt
        </button>
      </div>
    </div>
  </div>

  <div class="glass rounded-3xl p-6 sm:p-10 border border-stone-200/80 shadow-2xl animate-fade-in space-y-8">
    
    <!-- Top Success Badge -->
    <div class="text-center space-y-3">
      <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto shadow-inner">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
      </div>

      <span class="text-[10px] uppercase tracking-[0.3em] text-brand-plum font-bold block">Bespoke Atelier Order</span>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-brand-dark">Order Confirmed</h1>
      <p class="text-xs sm:text-sm text-stone-500 max-w-md mx-auto">
        Thank you, <strong class="text-brand-dark"><%= order.customer_name %></strong>. Your bespoke order has been registered and placed into atelier review.
      </p>
    </div>

    <!-- Order Metadata Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      
      <!-- Order Ref & Status -->
      <div class="p-4 rounded-xl bg-stone-50/90 border border-stone-200/80 space-y-2.5">
        <div class="flex justify-between items-center">
          <span class="text-stone-500">Order Reference:</span>
          <span class="font-mono font-bold text-brand-dark text-sm"><%= order.order_number %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-stone-500">Verification Status:</span>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            <%= order.status %> (Waiting for Admin Confirmation)
          </span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-stone-500">Placed On:</span>
          <span class="font-medium text-stone-700"><%= new Date(order.created_at || Date.now()).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
        </div>
      </div>

      <!-- Payment & Courier -->
      <div class="p-4 rounded-xl bg-stone-50/90 border border-stone-200/80 space-y-2.5">
        <div class="flex justify-between items-center">
          <span class="text-stone-500">Payment Method:</span>
          <span class="font-bold text-brand-dark flex items-center gap-1.5">
            <% if (order.payment_method === 'bKash') { %>
              <img src="/images/payments/bkash.png" alt="bKash" class="w-4 h-4 rounded object-contain shrink-0 border border-stone-200/60 shadow-2xs">
            <% } else if (order.payment_method === 'Nagad') { %>
              <img src="/images/payments/nagad.jpg" alt="Nagad" class="w-4 h-4 rounded object-contain shrink-0 border border-stone-200/60 shadow-2xs">
            <% } else if (order.payment_method === 'Online Bank Transfer' || (order.payment_method && order.payment_method.includes('Bank'))) { %>
              <img src="/images/payments/banking.jpg" alt="Banking" class="w-4 h-4 rounded object-contain shrink-0 border border-stone-200/60 shadow-2xs">
            <% } else { %>
              <img src="/images/payments/COD.jpg" alt="COD" class="w-4 h-4 rounded object-contain shrink-0 border border-stone-200/60 shadow-2xs">
            <% } %>
            <span><%= order.payment_method %></span>
          </span>
        </div>
        <% if (order.transaction_id) { %>
          <div class="flex justify-between items-center">
            <span class="text-stone-500">Transaction ID:</span>
            <span class="font-mono font-bold text-purple-900 bg-purple-100 px-2 py-0.5 rounded text-[11px]"><%= order.transaction_id %></span>
          </div>
        <% } %>
        <div class="flex justify-between items-center">
          <span class="text-stone-500">Courier Dispatch:</span>
          <span class="font-semibold text-emerald-700">Insured Hand Delivery</span>
        </div>
      </div>

    </div>

    <!-- Delivery Coordinates Card -->
    <div class="p-4 rounded-xl bg-purple-50/40 border border-purple-200/60 text-xs space-y-2">
      <div class="flex items-center gap-1.5 text-brand-plum font-bold uppercase tracking-wider text-[10px]">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
        <span>Delivery Coordinates</span>
      </div>
      <p class="text-stone-800 font-medium leading-relaxed">
        <%= order.delivery_address %>
      </p>
      <div class="flex items-center gap-4 text-stone-500 pt-1 text-[11px] flex-wrap">
        <span>Contact: <strong class="text-stone-700">+88 <%= order.customer_phone %></strong></span>
        <% if (order.customer_email) { %>
          <span>•</span>
          <span>Email: <strong class="text-stone-700"><%= order.customer_email %></strong></span>
        <% } %>
        <span>•</span>
        <span>Estimated Handover: <strong class="text-stone-700">Within 24-48 Hours</strong></span>
      </div>
    </div>

    <!-- Ordered Pieces List -->
    <div class="border-t border-stone-200 pt-5 space-y-4">
      <h2 class="font-heading text-base font-bold text-brand-dark">Ordered Creations (<%= items.length %>)</h2>

      <div class="divide-y divide-stone-100">
        <% items.forEach(function(item) { %>
          <div class="py-3 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <h3 class="font-heading text-sm font-semibold text-brand-dark truncate"><%= item.title %></h3>
              <span class="text-xs text-stone-500">Qty: <%= item.quantity %> &times; ৳<%= Number(item.price).toLocaleString() %></span>
            </div>
            <div class="text-right shrink-0">
              <span class="font-heading font-bold text-sm text-brand-dark">৳<%= Number(item.price * item.quantity).toLocaleString() %></span>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Cost Breakdown -->
      <div class="pt-3 border-t border-stone-200 text-xs space-y-2">
        <div class="flex justify-between text-stone-600">
          <span>Subtotal</span>
          <span class="font-semibold text-stone-800">৳<%= Number(items.reduce((acc, it) => acc + (it.price * it.quantity), 0)).toLocaleString() %></span>
        </div>
        <div class="flex justify-between items-center text-stone-600">
          <span class="flex items-center gap-1.5">
            <span>Delivery Charge</span>
            <% if (order.delivery_charge === 70) { %>
              <span class="text-[10px] bg-purple-50 text-purple-800 px-1.5 py-0.5 rounded font-medium border border-purple-200">Inside Dhaka (৳70)</span>
            <% } else if (order.delivery_charge === 160) { %>
              <span class="text-[10px] bg-stone-100 text-stone-700 px-1.5 py-0.5 rounded font-medium border border-stone-200">Outside Dhaka (৳160)</span>
            <% } else if (order.coupon_code) { %>
              <span class="text-[10px] bg-emerald-50 text-emerald-800 px-1.5 py-0.5 rounded font-medium border border-emerald-200">Free Delivery</span>
            <% } %>
          </span>
          <span class="font-semibold <%= (order.coupon_code || order.delivery_charge === 0) ? 'text-emerald-700 font-bold' : 'text-stone-800' %>">
            <% if (order.coupon_code || order.delivery_charge === 0) { %>
              <span class="line-through text-stone-400 mr-1.5">৳<%= (order.delivery_charge === 70 ? 70 : 160) %></span> Free
            <% } else { %>
              ৳<%= Number(order.delivery_charge || 0).toLocaleString() %>
            <% } %>
          </span>
        </div>
        <% if (order.coupon_code) { %>
          <div class="flex justify-between text-emerald-700 bg-emerald-50/70 p-2 rounded-lg border border-emerald-200/60">
            <span class="flex items-center gap-1">🎟️ Coupon Applied (<strong class="font-mono"><%= order.coupon_code %></strong>)</span>
            <span class="font-semibold">-100% Delivery Waived</span>
          </div>
        <% } %>
      </div>

      <div class="pt-3 border-t border-stone-200 flex justify-between items-baseline">
        <span class="font-heading text-base font-bold text-brand-dark">Grand Total</span>
        <span class="font-heading text-2xl font-bold text-brand-dark">৳<%= Number(order.total_amount).toLocaleString() %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4 border-t border-stone-200">
      <a href="/profile" class="btn-liquid justify-center text-xs py-3.5 px-6 font-semibold shadow-md text-white" style="background: linear-gradient(135deg, #3B0764 0%, #7E22CE 100%);">
        Check Order in Profile
      </a>
      <a href="/" class="btn-liquid justify-center text-xs py-3.5 px-6 font-semibold" style="background:#ffffff; color:#3B0764; border: 1.5px solid rgba(59,7,100,0.3);">
        Return to Storefront
      </a>
      <a href="/#featured" class="btn-liquid justify-center text-xs py-3.5 px-6 font-semibold text-stone-600 hover:text-stone-900 border border-stone-200 bg-stone-50">
        Browse More Pieces &rarr;
      </a>
    </div>

  </div>

</main>

<%- include('partials/footer') %>
